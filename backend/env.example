# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-service-role-secret-key-here

# Alpaca Trading API (Optional - for trade execution)
# Get these from: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_KEY=your-alpaca-key
ALPACA_SECRET=your-alpaca-secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# LLM Provider (Optional - for LLM features)
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gpt-4

# Environment
ENV=development
LOG_LEVEL=INFO

