# Financial Advisor Backend Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# Environment
ENV=development
LOG_LEVEL=INFO

# Supabase Configuration
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Alpaca Paper Trading API
# Get these from https://app.alpaca.markets/paper/dashboard/overview
ALPACA_KEY=your-alpaca-api-key
ALPACA_SECRET=your-alpaca-secret-key
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# LLM Provider (OpenAI, Anthropic, etc.)
# For OpenAI: Get from https://platform.openai.com/api-keys
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gpt-4
